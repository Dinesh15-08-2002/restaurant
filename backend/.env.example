# FastAPI Backend Environment Variables

PROJECT_NAME="Indian Restaurant API"
API_V1_STR="/api"
ENVIRONMENT="development"

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS="http://localhost:3000"

# PostgreSQL Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=restaurant_db

# Security & Authentication
JWT_SECRET_KEY="restaurant-secret-key-super-secure-change-in-prod-minimum32chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin Credentials
FIRST_SUPERUSER_EMAIL="admin@restaurant.com"
FIRST_SUPERUSER_PASSWORD="Admin@12345"
